</mxCell><mxCell id="leyenda" value="&lt;b&gt;Cómo se lee&lt;/b&gt;&lt;br&gt;Rectángulo azul: entidad. Rombo amarillo: relación.&lt;br&gt;1 y N (o N y M) en rojo: cardinalidad.&lt;br&gt;&lt;br&gt;Ejemplos:&lt;br&gt;• Un TORNEO se divide en N RONDAS.&lt;br&gt;• Un USUARIO organiza N TORNEOS y un TORNEO tiene M organizadores.&lt;br&gt;• Un PARTICIPANTE es una persona o un equipo inscripto en un torneo.&lt;br&gt;• Un ENFRENTAMIENTO tiene un participante local y otro visitante (si no hay visitante, el local pasa libre)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;strokeColor=#999999;fillColor=#f8f9fb;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="760" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Atributos" id="2 · Atributos"><mxGraphModel grid="0" page="1" pageWidth="2450" pageHeight="1760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Bramajo · Atributos de cada entidad (el subrayado es la clave primaria)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell><mxCell id="USUARIO" value="USUARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f45c4;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="305" y="372" width="190" height="56" as="geometry"/></mxCell><mxCell id="USUARIO_id_usuario" value="id_usuario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="330" y="166" width="140" height="38" as="geometry"/></mxCell><mxCell id="USUARIO_id_usuario_e" style="endArrow=none;html=1;strokeColor=#888888;" edge="1" parent="1" source="USUARIO" target="USUARIO_id_usuario"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="USUARIO_nombre" value="nombre" style="ellipse;whiteSpace=wrap;