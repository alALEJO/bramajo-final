><mxGeometry x="405" y="588" width="230" height="64" as="geometry"/></mxCell><mxCell id="aud" value="Registrar en auditoría" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="228" width="230" height="64" as="geometry"/></mxCell><mxCell id="des" value="Desbloquear cuenta" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="108" width="230" height="64" as="geometry"/></mxCell><mxCell id="as0" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as1" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as2" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as3" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as4" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as5" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org2" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="«include»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="a2" target="aud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="«include»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="a4" target="aud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="«extend»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="des" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="Corregir un resultado de una ronda ya cerrada lo puede hacer el administrador general o un organizador al que el administrador le dio permiso de corregir en ese torneo. La auditoría guarda el valor anterior y el nuevo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;strokeColor=#999999;fillColor=#f8f9fb;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1260" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>