rent="1"><mxGeometry x="895" y="468" width="230" height="64" as="geometry"/></mxCell><mxCell id="eli" value="Generar ronda de eliminación" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="558" width="230" height="64" as="geometry"/></mxCell><mxCell id="sui" value="Generar ronda suiza" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="648" width="230" height="64" as="geometry"/></mxCell><mxCell id="falta" value="Avisar resultados pendientes" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="808" width="230" height="64" as="geometry"/></mxCell><mxCell id="as0" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as1" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as2" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as3" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as4" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as5" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as6" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="o7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCel