<mxfile host="app.diagrams.net" agent="BoomeRam Solutions"><diagram name="1 · Actores" id="cu0"><mxGraphModel grid="0" page="1" pageWidth="900" pageHeight="760"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="Casos de uso — jerarquía de actores" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="pub" value="Usuario público" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="432" y="60" width="36" height="70" as="geometry"/></mxCell><mxCell id="par" value="Participante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="232" y="260" width="36" height="70" as="geometry"/></mxCell><mxCell id="org" value="Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632" y="260" width="36" height="70" as="geometry"/></mxCell><mxCell id="adm" value="Administrador general" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632" y="450" width="36" height="70" as="geometry"/></mxCell><mxCell id="r0" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;" edge="1" parent="1" source="par" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;" edge="1" parent="1" source="org" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;" edge="1" parent="1" source="adm" target="org"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="El triángulo hueco apunta al actor más general. El participante y el organizador pueden hacer todo lo del usuario público y además lo suyo; el administrador general puede hacer todo lo del organizador. Por eso cada caso de uso se une al actor de menor nivel que puede ejecutarlo." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;strokeColor=#999999;fillColor=#f8f9fb;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="860" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 · Público y participante" id="cu1"><mxGraphModel grid="0" page="1" pageWidth="1300" pageHeight="940"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="Casos de uso — usuario público y participante" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="sis" value="Bramajo — Sistema de Gestión Deportiva Modular" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;strokeColor=#1f45c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1000" height="760" as="geometry"/></mxCell><mxCell id="pub" value="Usuario público" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="220" width="36" height="70" as="geometry"/></mxCell><mxCell id="par" value="Participante" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="580" width="36" height="70" as="geometry"/></mxCell><mxCell id="u1" value="RF-U-01 Registrarse" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="118" width="230" height="64" as="geometry"/></mxCell><mxCell id="u2" value="RF-U-02 Iniciar sesión" style="ellipse;whiteSp