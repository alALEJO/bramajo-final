parent="1"><mxGeometry x="895" y="568" width="230" height="64" as="geometry"/></mxCell><mxCell id="as0" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="pub" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as1" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="pub" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as2" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="pub" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as3" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="pub" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as4" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="par" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as5" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="par" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as6" value="" style="endArrow=none;html=1;strokeColor=#333333;" edge="1" parent="1" source="par" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="«include»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="u1" target="aud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="«include»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="u2" target="aud"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="«extend»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="blo" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="«extend»" style="endArrow=open;dashed=1;html=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="cupo" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="" style="endArrow=block;endFill=0;endSize=16;html=1;strokeColor=#333333;" edge="1" parent="1" source="par" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="«include»: el paso se ejecuta siempre (todo ingreso y todo registro queda en auditoría). «extend»: solo en ciertas condiciones (la cuenta se bloquea al quinto intento fallido; el aviso de cupo aparece si el torneo está completo)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=8;strokeColor=#999999;fillColor=#f8f9fb;rounded=1;" vertex="1" parent="1"><mxGeometry x="20" y="850" width="1260" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 · Organizador" id="cu2"><mxGraphModel grid="0" page="1" pageWidth="1300" pageHeight="1020"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="Casos de uso — organizador de torneo" style="text;html=1;align=left;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="36" as="geometry"/></mxCell><mxCell id="sis" value="Bramajo — Sistema de Gestión Deportiva Modular" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;strokeColor=#1f45c4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="70" width="1000" height="850" as="geometry"/></mxCell><mxCell id="org" value="Organizador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="102" y="400" width="36" height="70" as="geometry"/></mxCell><mxCell id="o1" value="RF-O-01 Crear y configurar torneo" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eef3ff;strokeColor=#1f45c4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="405" y="108" width="230" height="64" as="geometry"/></mxCell><mxCell id="o2" value="RF-O-02 Gestionar equipos" style="