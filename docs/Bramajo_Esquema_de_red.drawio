<mxfile host="app.diagrams.net"><diagram name="Esquema de red" id="red"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="usuarios" value="&lt;b&gt;Usuarios (internet)&lt;/b&gt;&lt;br&gt;Navegador en PC o celular&lt;br&gt;Visitantes, participantes,&lt;br&gt;organizadores y administradores" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="290" height="120" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;PC de administración&lt;/b&gt;&lt;br&gt;Red del instituto&lt;br&gt;SSH solo con clave pública" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="290" height="100" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;Docker Hub&lt;/b&gt;&lt;br&gt;usuario/bramajo-web:1.0&lt;br&gt;usuario/bramajo-db:1.0" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1130" y="20" width="330" height="90" as="geometry"/></mxCell><mxCell id="zabbix" value="&lt;b&gt;Servidor Zabbix del instituto&lt;/b&gt;&lt;br&gt;Consulta el agente por el 10050" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="290" height="80" as="geometry"/></mxCell><mxCell id="servidor" value="&lt;b&gt;Servidor AlmaLinux 8.10 · máquina virtual en Proxmox&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="1060" height="700" as="geometry"/></mxCell><mxCell id="firewall" value="&lt;b&gt;firewalld (zona public)&lt;/b&gt;&lt;br&gt;Entrada: 80 y 443 desde cualquiera · 22 solo desde la red del instituto&lt;br&gt;Todo lo demás se descarta · el 3306 nunca entra" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="1000" height="80" as="geometry"/></mxCell><mxCell id="host" value="&lt;b&gt;Servicios del sistema operativo&lt;/b&gt;&lt;br&gt;sshd + fail2ban (3 intentos → bloqueo)&lt;br&gt;ClamAV (escaneo diario de /opt/bramajo)&lt;br&gt;cron: backup.sh 02:00 · monitoreo.sh cada 5 min&lt;br&gt;Agente Zabbix (10050)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="380" height="170" as="geometry"/></mxCell><mxCell id="docker" value="&lt;b&gt;Docker · red interna «sistema_default»&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#f5faff;strokeColor=#1f45c4;dashed=1;" vertex="1" parent="1"><mxGeometry x="850" y="320" width="580" height="500" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;bramajo_web · php:8.3-apache&lt;/b&gt;&lt;br&gt;Publica 80 (redirige) y 443 (TLS)&lt;br&gt;Cabeceras CSP, HSTS, X-Frame-Options&lt;br&gt;Volumen «claves»: AES, RSA y SSL" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="370" width="520" height="150" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;bramajo_db · mysql:8.0&lt;/b&gt;&lt;br&gt;Escucha 3306 solo en la red interna&lt;br&gt;bramajo_app: permisos mínimos (DCL)&lt;br&gt;bramajo_backup: solo lectura&lt;br&gt;Volumen «datos»" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="620" width="520" height="170" as="geometry"/></mxCell><mxCell id="respaldos" value="&lt;b&gt;/var/backups/bramajo&lt;/b&gt;&lt;br&gt;14 días de copias .sql.gz + claves&lt;br&gt;Permisos 700, solo root" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="380" height="110" as="geometry"/></mxCell><mxCell id="f0" value="HTTPS 443 / HTTP 80" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="usuarios" target="firewall"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f1" value="80, 443" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="firewall" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f2" value="TCP 3306 (red interna)" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="web" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f3" value="SSH 22" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="admin" target="host"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f4" value="docker pull (salida 443)" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="hub" target="servidor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f5" value="docker exec mysqldump" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="host" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f6" value="backup.sh" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="host" target="respaldos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f7" value="10050" style="endArrow=block;html=1;fontColor=#b85450;" edge="1" parent="1" source="zabbix" target="host"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>