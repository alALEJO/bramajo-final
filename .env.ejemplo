# Copiar este archivo como .env y cambiar las contraseñas. El .env no se sube a Git ni a Docker Hub.
# Usuario de Docker Hub donde se publican las imágenes, y versión a usar.
DOCKERHUB_USUARIO=tu_usuario
VERSION=1.0
DB_CLAVE_ROOT=CambiarRoot2026
DB_CLAVE=CambiarApp2026
DB_CLAVE_BACKUP=CambiarBackup2026
# IP o nombre del servidor, para el certificado SSL
NOMBRE_SERVIDOR=localhost
